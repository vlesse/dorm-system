# 复制为 .env 后按需修改（npm run setup 会自动帮你复制一份）

# Prisma 连接串。默认 SQLite 单文件，路径相对于 server/prisma/
DATABASE_URL="file:./dorm.db"

# 后端端口。用 API_PORT 而不是 PORT —— 有些工具链会注入 PORT 抢占前端端口
API_PORT=3101

# 监听地址。开发默认 0.0.0.0（方便手机连同一局域网调自助端）
# 生产必须设成 127.0.0.1，由前面的 nginx 反代并终结 TLS
# API_HOST=127.0.0.1

# JWT 签名密钥。开发环境不设会用代码里的默认值；
# NODE_ENV=production 时不设会**拒绝启动** —— 代码是公开的，默认值谁都知道。
# 生成：openssl rand -hex 32
# JWT_SECRET=

# 生产环境设成 production（影响上面的密钥检查和下面的验证码回显默认值）
# NODE_ENV=production

# 员工自助端验证码是否直接显示在登录页（不走短信 / WhatsApp）。
# 非生产环境默认开；生产环境默认关，只有演示站才应该显式设成 true。
# SELF_OTP_ECHO=true

# 信任哪些反向代理传来的 X-Forwarded-For。默认 loopback（本机 nginx）。
# 不信任的话审计日志里的 IP 全是 127.0.0.1，登录限流也没法按 IP 算
# TRUST_PROXY=loopback
