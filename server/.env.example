# 复制为 .env 后按需修改（npm run setup 会自动帮你复制一份）

# Prisma 连接串。默认 SQLite 单文件，路径相对于 server/prisma/
DATABASE_URL="file:./dorm.db"

# 后端端口。用 API_PORT 而不是 PORT —— 有些工具链会注入 PORT 抢占前端端口
API_PORT=3101

# 监听地址。开发默认 0.0.0.0（方便手机连同一局域网调自助端）
# 生产必须设成 127.0.0.1，由前面的 nginx 反代并终结 TLS
# API_HOST=127.0.0.1

# JWT 签名密钥。不设会用代码里的开发默认值 —— 生产环境必须换掉，
# 否则任何人都能伪造管理员 token。生成：openssl rand -hex 32
# JWT_SECRET=
