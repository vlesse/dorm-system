{
  "name": "dorm-system",
  "private": true,
  "version": "0.1.0",
  "description": "青山园区宿舍管理系统 / Dormitory Management System (IMIP)",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev -w server",
    "dev:web": "npm run dev -w web",
    "db:push": "npm run db:push -w server",
    "db:seed": "npm run db:seed -w server",
    "setup": "npm install && npm run env:init && npm run db:push && npm run db:seed",
    "env:init": "node -e \"const fs=require('fs');if(!fs.existsSync('server/.env')){fs.copyFileSync('server/.env.example','server/.env');console.log('已创建 server/.env')}\""
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
